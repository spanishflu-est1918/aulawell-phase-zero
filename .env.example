# Copy to .env.local for local use, and add the same variables in your Vercel
# project settings (Settings → Environment Variables) for the live site.
# Until these are set, the booking calendar shows a friendly "almost ready"
# message and the rest of the site works normally.

# Cal.com (free account): Settings → Security → API keys → create key
CAL_API_KEY=

# Cal.com event type id: create a "Lesson" event type (60 min), the id is the
# number in its URL, e.g. app.cal.com/event-types/123456 → 123456
CAL_EVENT_TYPE_ID=

# Stripe (stripe.com → Developers → API keys → Secret key, sk_live_... or sk_test_...)
# Keep this server-side only. Never prefix it with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret: Developers → Webhooks → Add endpoint
#   URL: https://YOUR-DOMAIN/api/stripe-webhook
#   Event: checkout.session.completed
# Online booking remains disabled until both Stripe variables are configured.
STRIPE_WEBHOOK_SECRET=
